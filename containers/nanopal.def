Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    apt-get update
    apt-get install -y --no-install-recommends build-essential

    pip install --no-cache-dir biopython==1.87 intervaltree==3.2.1 pysam==0.24.0 sortedcontainers==2.4.0 ssw-py==1.0.1

    apt-get purge -y --auto-remove build-essential
    apt-get autoclean
    rm -rf /var/lib/apt/lists/*
